# Commentary is disabled by default. Both this opt-in and an API key are required.
COMMENTARY_ENABLED=false

# OpenAI API Key (only used when commentary is explicitly enabled)
# Get your key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk_live_your_key_here

# Optional: Commentary engine configuration
# COMMENTARY_TEXT_MODEL=gpt-3.5-turbo
# COMMENTARY_TTS_MODEL=tts-1
# COMMENTARY_TTS_VOICE=onyx
# COMMENTARY_COOLDOWN_SECONDS=6.0
# COMMENTARY_ENABLE_AUDIO=true
